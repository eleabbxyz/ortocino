# Sostituisci il dominio e configura DNS A/AAAA prima di avviare Caddy.
ortovicino.example.com {
    encode zstd gzip
    root * /srv/ortovicino/frontend/dist
    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:4000
    }
    handle {
        try_files {path} /index.html
        file_server
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.basemaps.cartocdn.com https://*.tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
}
